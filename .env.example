# Central Hiraya.Api — website, desktop, and mobile share this hub.
# Do not put database passwords or session secrets in NEXT_PUBLIC_ / VITE_ / EXPO_PUBLIC_ variables.

# Local API
HIRAYA_API_URL=http://127.0.0.1:5188
NEXT_PUBLIC_API_URL=http://127.0.0.1:5188
VITE_API_URL=http://127.0.0.1:5188
API_URL=http://127.0.0.1:5188

# Vercel (server only): same origin /api is proxied to this URL
# HIRAYA_API_INTERNAL=https://hiraya-api.onrender.com

# Hosted desktop/mobile builds (compile-time)
# VITE_API_URL=https://hiraya-api.onrender.com
# EXPO_PUBLIC_API_URL=https://hiraya-api.onrender.com

# API process only (never commit real values)
# HIRAYA_MYSQL=mysql://USER:PASSWORD@HOST:3306/hiraya_learning_center
# HIRAYA_MYSQL_CA=backend/Hiraya.Api/aiven-ca.pem
# HIRAYA_SESSION_SECRET=generate-a-long-random-string-for-production
# HIRAYA_PUBLIC_URL=https://www.hirayalearningcenter.app
# HIRAYA_CORS_ORIGINS=https://www.hirayalearningcenter.app,https://hirayalearningcenter.app
