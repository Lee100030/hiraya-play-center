# Existing Hiraya.Api (do not put database passwords or JWT/session secrets here)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5188
EXPO_PUBLIC_API_URL=http://127.0.0.1:5188
VITE_API_URL=http://127.0.0.1:5188
API_URL=http://127.0.0.1:5188

# Android emulator talking to the host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5188

# Backend (set in the API process, never in client bundles)
# Aiven MySQL (Singapore): copy Service URI from console.aiven.io
# HIRAYA_MYSQL=mysql://avnadmin:PASSWORD@mysql-XXXX.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED
# HIRAYA_MYSQL_CA=backend/Hiraya.Api/aiven-ca.pem
# Website (Vercel): Aiven Service URI — server env only, never NEXT_PUBLIC_
# HIRAYA_MYSQL=mysql://avnadmin:PASSWORD@mysql-XXXX.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED
