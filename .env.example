# Central Hiraya.Api — website, desktop, and mobile share this hub.
# Do not put database passwords or session secrets in client-only NEXT_PUBLIC_ / VITE_ / EXPO_PUBLIC_ variables.

# Server-side URL used by Next.js to proxy /api/* (preferred on Vercel)
# HIRAYA_API_INTERNAL=https://your-hiraya-api.example.com

HIRAYA_API_URL=http://127.0.0.1:5188
NEXT_PUBLIC_API_URL=http://127.0.0.1:5188
VITE_API_URL=http://127.0.0.1:5188
API_URL=http://127.0.0.1:5188

# Expo Go on a real phone: omit EXPO_PUBLIC_API_URL so the app uses the Metro LAN IP.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5188
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5188

# API process only (never commit real values)
# HIRAYA_MYSQL=mysql://USER:PASSWORD@HOST:3306/hiraya_learning_center
# HIRAYA_MYSQL_CA=backend/Hiraya.Api/aiven-ca.pem
# HIRAYA_SESSION_SECRET=generate-a-long-random-string-for-production
