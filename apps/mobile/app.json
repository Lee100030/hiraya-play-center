{
  "expo": {
    "name": "HIRAYA",
    "slug": "hiraya-learning-center",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hiraya",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hiraya.learningcenter",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.hiraya.learningcenter",
      "adaptiveIcon": { "backgroundColor": "#0B3D2E" },
      "permissions": []
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "eas": {}
    },
    "experiments": { "typedRoutes": true }
  }
}
