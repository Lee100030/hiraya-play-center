# Optional. Leave unset for Expo Go on a real phone: the app uses the same LAN
# IP as Metro (scan the QR from Expo Go on Android or iOS).
#
# Do not point a physical phone at 127.0.0.1 — that is the phone itself.
# Android emulator (not Expo Go on a device):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5188
#
# Hosted API:
# EXPO_PUBLIC_API_URL=https://your-api.example.com
