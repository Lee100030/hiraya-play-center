{
  "name": "@hiraya/desktop",
  "description": "HIRAYA desktop app (Electron) — not a Vercel website",
  "version": "1.0.9",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "lint": "echo ok",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hiraya/api": "workspace:*",
    "@hiraya/config": "workspace:*",
    "@hiraya/types": "workspace:*",
    "@hiraya/ui": "workspace:*",
    "@hiraya/utils": "workspace:*",
    "@hiraya/validation": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "app.hirayalearningcenter.desktop",
    "productName": "HIRAYA Desktop",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/images/hiraya-crest.png",
      "signAndEditExecutable": false,
      "publisherName": "Hiraya Kids Learning Center"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
