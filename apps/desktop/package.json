{
  "name": "@hiraya/desktop",
  "version": "1.0.0",
  "description": "HIRAYA Desktop — Learning Center operations client",
  "author": "HIRAYA Learning Center",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "package": "vite build && electron-builder --win zip --x64",
    "package:nsis": "vite build && electron-builder --win nsis --x64",
    "package:linux": "vite build && electron-builder --linux dir",
    "lint": "echo ok",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hiraya/api": "workspace:*",
    "@hiraya/config": "workspace:*",
    "@hiraya/types": "workspace:*",
    "@hiraya/ui": "workspace:*",
    "@hiraya/utils": "workspace:*",
    "@hiraya/validation": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.hiraya.learningcenter.desktop",
    "productName": "HIRAYA Desktop",
    "artifactName": "HIRAYA-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "zip",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
